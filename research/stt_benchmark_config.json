  "phase_1_request_counts": {
    "models": ["gpt-4o-transcribe", "gpt-4o-mini-transcribe", "whisper-1"],
    "conditions": ["auto", "hint"],
    "languages": ["uz", "kk"],
    "utterances_per_language": 300,
    "requests_per_model": 1200,
    "total_phase_1_requests": 3600,
    "hard_cap_requests": 4000,
    "total_audio_minutes_estimate": {
      "uzbek_minutes": 21.8,
      "kazakh_minutes": 37.2,
      "combined_minutes_per_model_per_condition": 59.0,
      "combined_minutes_phase_1_all_models_both_conditions": 354.0
    }
  },

  "retry_policy": {
    "http_5xx": {"max_retries": 3, "backoff_seconds": [1, 2, 4]},
    "http_429": {"max_retries": 5, "backoff_strategy": "Retry-After header or 60s"},
    "http_4xx_not_429": {"max_retries": 0, "action": "record_as_error"},
    "empty_or_malformed": {"max_retries": 1, "action": "record_as_error_if_still_malformed"},
    "timeout_s": 120,
    "timeout_action": "record_as_timeout_no_retry"
  },

  "output_schema_fields": [
    "run_id", "call_id", "timestamp_utc", "provider", "model", "model_version",
    "client_region", "api_region", "audio_id", "audio_sha256", "audio_duration_s",
    "audio_format", "corpus_source", "contamination_risk", "language_condition",
    "language_hint", "prompt", "response_format", "raw_transcription",
    "normalized_transcription", "provider_detected_language",
    "independent_detected_language", "dominant_script", "latency_ms",
    "http_status", "error_type", "error_message", "retry_count",
    "cost_usd", "cost_list_price_usd", "sdk_version", "benchmark_version"
  ],

  "normalisation_pipeline": {
    "version": "1.0",
    "steps": [
      "unicode_nfc",
      "casefold",
      "apostrophe_normalise_to_u0027",
      "punctuation_remove_at_word_boundaries",
      "whitespace_collapse_to_ascii_space",
      "NO_cross_script_transliteration"
    ]
  },

  "evaluation_metrics": {
    "wer": {"tool": "jiwer", "input": "normalized_transcription"},
    "cer": {"tool": "jiwer", "input": "normalized_transcription", "level": "character"},
    "script_accuracy": {
      "method": "unicode_block_classification",
      "dominance_threshold": 0.70,
      "labels": ["latin", "cyrillic", "arabic", "mixed", "other", "empty"],
      "expected_script": {"uz": "latin", "kk": "cyrillic"}
    },
    "provider_lid_accuracy": {
      "source": "provider_detected_language",
      "conditions": ["auto"],
      "note": "N/A (not zero) when provider never returns detected_language"
    },
    "output_lid_accuracy": {
      "source": "independent_detected_language",
      "tool": "fasttext",
      "tool_pip_package": "fasttext-wheel==0.9.2",
      "tool_model_file": "lid.176.bin",
      "tool_model_url": "https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.bin",
      "tool_model_hash_sha256": "RECORD_AFTER_DOWNLOAD",
      "tool_evidence": "CONFIRMED",
      "tool_evidence_note": "lid.176 supports both uz (Uzbek) and kk (Kazakh) — confirmed per fasttext.cc language identification docs, 2026-08-23",
      "tool_rejected": {
        "langdetect": "DISQUALIFIED — insufficient language coverage, does not include both uz and kk",
        "lingua==2.2.0": "DISQUALIFIED — Uzbek (uz) not supported in 75-language set"
      },
      "min_words_for_lid": 10,
      "conditions": ["auto", "hint"]
    },
    "hallucination_types": [
      {
        "type": "silence_hallucination",
        "signal": "non_empty_output_when_audio_near_silent",
        "detection": "automatic_rms_energy_threshold",
        "threshold_status": "NEEDS_CALIBRATION"
      },
      {
        "type": "excessive_output",
        "signal": "word_count_gt_3x_expected_at_2.5_words_per_second",
        "detection": "automatic_flag_human_review_required"
      },
      {
        "type": "unrelated_language_output",
        "signal": "output_in_non_turkic_language_for_central_asian_audio",
        "detection": "semi_automatic_output_lid"
      },
      {
        "type": "semantic_hallucination",
        "signal": "correct_script_language_but_content_does_not_correspond",
        "detection": "human_review_wer_gt_80pct_correct_script"
      }
    ]
  },

  "directory_structure": {
    "benchmark/config/": "Configuration files",
    "benchmark/raw/<run_id>/<provider>/<model>/<condition>/<language>/": "Per-call JSON records + raw provider responses",
    "benchmark/normalized/<run_id>/": "Normalized transcript CSVs",
    "benchmark/results/<run_id>/": "Leaderboards, confusion matrices, hallucination report, per_call_results.parquet",
    "benchmark/logs/<run_id>/": "run.log, errors.log, cost_estimate.txt, cost_actual.txt"
  },

  "pre_run_checklist": [
