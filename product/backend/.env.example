# Copy to .env and fill in your values. Never commit .env.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Used only until a voice is enrolled via /api/voice/enroll (enrollment wins):
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Enrolled voice ids are stored OUTSIDE the repo (default ~/.birovoz_voice.json):
# BIROVOZ_VOICE_CONFIG=
#
# Local clone (Uzbek only): vendored Sayro -> external Seed-VC V2.
# Model checkouts, interpreters and reference audio stay outside Git.
# Current backend automatically uses --daemon where supported and falls
# back to the one-shot wrapper on failure. Restart after configuration changes.
# SAYRO_SCRIPT=product/backend/services/routeb/b_sayro_then_seedvc.py
# SAYRO_PYTHON=C:\path\to\sayro-venv\Scripts\python.exe
# SEEDVC_PYTHON=C:\path\to\seed-vc\.venv\Scripts\python.exe
# SEEDVC_DIR=C:\path\to\seed-vc
# SEEDVC_REFERENCE_WAV=C:\path\to\reference\my_voice.wav
SEEDVC_VERSION=v2
# Listening-approved Uzbek profile (2026-10-12). Use 15 to restore the previous baseline.
ROUTE_B_DIFFUSION_STEPS=10
ROUTE_B_LENGTH_ADJUST=1.0
ROUTE_B_INTELLIGIBILITY=0.8
ROUTE_B_SIMILARITY=0.8
# ROUTE_B_EXTRA_ARGS=
LOCAL_CLONE_TIMEOUT_S=300
# Loopback only. 0.0.0.0 exposes the paid, unauthenticated API to your network.
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
STT_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy
UPLOAD_DIR=./uploads
AUDIO_OUTPUT_DIR=./audio_output
LOG_DIR=./logs
