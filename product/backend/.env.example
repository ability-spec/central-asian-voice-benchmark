# Copy to .env and fill in your values. Never commit .env.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Used only until a voice is enrolled via /api/voice/enroll (enrollment wins):
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Enrolled voice ids are stored OUTSIDE the repo (default ~/.birovoz_voice.json):
# BIROVOZ_VOICE_CONFIG=
#
# CP5 — Local clone via voice-lab Route B (b_sayro_then_seedvc.py).
# All paths live OUTSIDE the repository; nothing is copied into the
# product tree. Leave blank to keep the feature disabled; Standard/OpenAI
# is the default and the runtime fallback. Route B is Uzbek-only in MVP
# (Kazakh stays on OpenAI).
#
# The wrapper CLI actually used:
#   <SAYRO_PYTHON> <SAYRO_SCRIPT> --stage all
#     --sentences <temp sentences dir> --only 1 --out <temp out dir>
#     --target <SEEDVC_REFERENCE_WAV>
#     --seedvc-python <SEEDVC_PYTHON> --seedvc-dir <SEEDVC_DIR>
#     --seedvc-version v1
# (cwd = SAYRO_VOICE_LAB_DIR; wrapper handles Sayro load/teardown + Seed-VC
# V1 internally with its known-good flags.)
# SAYRO_VOICE_LAB_DIR=C:\Users\erkin\voice-lab
# SAYRO_SCRIPT=b_sayro_then_seedvc.py
# SAYRO_PYTHON=C:\Users\erkin\voice-lab\.venv\Scripts\python.exe
# SEEDVC_PYTHON=C:\Users\erkin\seed-vc\.venv\Scripts\python.exe
# SEEDVC_DIR=C:\Users\erkin\seed-vc
# SEEDVC_REFERENCE_WAV=C:\Users\erkin\voice-lab\reference\my_voice.wav
# ROUTE_B_EXTRA_ARGS=
# LOCAL_CLONE_TIMEOUT_S=180
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
STT_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy
UPLOAD_DIR=./uploads
AUDIO_OUTPUT_DIR=./audio_output
LOG_DIR=./logs
